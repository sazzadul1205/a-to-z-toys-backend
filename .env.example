
This template documents every environment variable the API reads. The app does
NOT load dotenv — set these in your shell, a process manager, or source this
file (`set -a; source .env.example; set +a`) before starting the server. Nothing
here should ever contain a real production secret; commit this example only.

## Server / security
PORT=3000
# Storefront origin allowed to hit the API. Use "*" for local dev.
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

## Storage backend  (DATA_SOURCE selects the engine)
# json  — one <collection>.json file per table under DATA_DIR (default behaviour)
# sqlite — a single SQLite database; set DB_SQLITE_PATH to control the file
# mysql  — MySQL/MariaDB; set the DB_* credentials below
DATA_SOURCE=json
DATA_DIR=./data
DB_SQLITE_PATH=./data/sqlite.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=a_to_z_kids_world
# Boot-time CREATE TABLE IF NOT EXISTS. Set to false to manage schema yourself.
DB_SYNC=true

## Feature flags
ORDER_PROCESSING=enabled
INVENTORY_MANAGEMENT=enabled

## Rate limits  (raise these for a browser E2E run — see backend README)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
REVIEW_SUBMIT_LIMIT=10
REVIEW_SUBMIT_WINDOW_MS=3600000
